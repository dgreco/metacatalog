<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.davidgreco</groupId>
        <artifactId>metacatalog</artifactId>
        <version>1.0.1</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>it.davidgreco.metacatalog</groupId>
    <artifactId>metacatalog-ui</artifactId>
    <name>Meta Catalog UI</name>

    <dependencies>
        <!--
          OpenAPI module: the UI calls the REST API exclusively, through MetacatalogApiDelegate.
          metacatalog-core and metacatalog-functions are deliberately kept off this module's
          compile classpath: the UI must not reach past the API into the service or procedure
          layer. Declaring no direct dependency is not enough, because both arrive transitively
          through metacatalog-openapi — hence the explicit exclusions below, which turn a stray
          `import ...metacatalog.service.*` or `...metacatalog.functions.*` into a compile error
          instead of leaving the rule to convention.

          The exclusion is compile-scope only. At runtime metacatalog-application assembles both
          modules, so the delegate implementation still finds its services; the UI simply cannot
          reference them itself. Anything a page needs must be exposed as an endpoint first.
        -->
        <dependency>
            <groupId>it.davidgreco.metacatalog</groupId>
            <artifactId>metacatalog-openapi</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>it.davidgreco.metacatalog</groupId>
                    <artifactId>metacatalog-core</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>it.davidgreco.metacatalog</groupId>
                    <artifactId>metacatalog-functions</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Spring MVC controllers + server-side rendering with Thymeleaf -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Enforcer Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <!-- JaCoCo Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!-- Spotless Plugin for Code Formatting -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <!-- licensescan Maven plugin for License check -->
            <plugin>
                <groupId>com.github.carlomorelli</groupId>
                <artifactId>licensescan-maven-plugin</artifactId>
            </plugin>

            <!-- maven-surefire-plugin to run unit tests through the command line -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
