[PrefixDeclaration]
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
owl:		http://www.w3.org/2002/07/owl#
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#
mt:         http://metacatalog/

[MappingDeclaration] @collection [[

mappingId	MAPPING-ID-TRAIT
target		mt:Trait/id={id} a mt:Trait ; mt:id {id}^^xsd:string ; mt:name {name}^^xsd:string ; mt:baseSchema {base_schema}^^xsd:string ; mt:derivedSchema {derived_schema}^^xsd:string .
source		SELECT * FROM "trait" as Trait

mappingId	MAPPING-ID-TYPES
target		mt:EntityType/id={id} a mt:EntityType ; mt:id {id}^^xsd:string ; mt:name {name}^^xsd:string ; mt:baseSchema {base_schema}^^xsd:string ; mt:derivedSchema {derived_schema}^^xsd:string .
source		SELECT * FROM "entity_type" as EntityType

mappingId	MAPPING-ID-TRAIT-RELATIONSHIP-DEPENDS_ON
target		mt:Trait/id={source_trait_id} mt:dependsOn mt:Trait/id={target_trait_id} .
source		SELECT "trait_relationship"."source_id" AS "source_trait_id", "trait_relationship"."target_id" AS "target_trait_id" FROM "trait_relationship" WHERE "trait_relationship"."relation_type" = 'DEPENDS_ON'

mappingId	MAPPING-ID-TRAIT-RELATIONSHIP-HAS_PART
target		mt:Trait/id={source_trait_id} mt:hasPart mt:Trait/id={target_trait_id} .
source		SELECT "trait_relationship"."source_id" AS "source_trait_id", "trait_relationship"."target_id" AS "target_trait_id" FROM "trait_relationship" WHERE "trait_relationship"."relation_type" = 'HAS_PART'

mappingId	MAPPING-ID-TYPE-RELATIONSHIP-HAS-TRAIT
target		mt:EntityType/id={entity_type_id} mt:hasTrait mt:Trait/id={trait_id} .
source		SELECT "type_traits"."entity_type_id" AS "entity_type_id", "type_traits"."trait_id" AS "trait_id" FROM "type_traits"

mappingId	MAPPING-ID-TYPE-INHERITS-FROM
target		mt:EntityType/id={entity_type_FK_id} mt:inheritsFrom mt:EntityType/id={entity_type_FKR_id} .
source		SELECT "entity_type_FK"."id" AS "entity_type_FK_id", "entity_type_FKR"."id" AS "entity_type_FKR_id" FROM "entity_type" AS "entity_type_FK", "entity_type" AS "entity_type_FKR" WHERE "entity_type_FK"."father_id" = "entity_type_FKR"."id"

mappingId	MAPPING-ID-TRAIT-INHERITS-FROM
target		mt:Trait/id={trait_FK_id} mt:inheritsFrom mt:Trait/id={trait_FKR_id} .
source		SELECT "trait_FK"."id" AS "trait_FK_id", "trait_FKR"."id" AS "trait_FKR_id" FROM "trait" AS "trait_FK", "trait" AS "trait_FKR" WHERE "trait_FK"."father_id" = "trait_FKR"."id"

]]

