apiVersion: v1
kind: Secret
metadata:
  name: gitlab-registry-credentials
  namespace: applications
  labels:
    app.kubernetes.io/name: metacatalog
type: kubernetes.io/dockerconfigjson
stringData:
  # Generate the actual secret with:
  # kubectl create secret docker-registry gitlab-registry-credentials \
  #   --docker-server=gitlab.davidgreco.it:5050 \
  #   --docker-username=<deploy-token-username> \
  #   --docker-password=<deploy-token-password> \
  #   --namespace=applications
  #
  # Or copy this file to registry-secret.yaml and fill in the values:
  .dockerconfigjson: |
    {
      "auths": {
        "gitlab.davidgreco.it:5050": {
          "username": "REPLACE_WITH_USERNAME",
          "password": "REPLACE_WITH_TOKEN",
          "auth": "REPLACE_WITH_BASE64_USERNAME_COLON_PASSWORD"
        }
      }
    }