[PrefixDeclaration]
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#
owl:		http://www.w3.org/2002/07/owl#
xsd:		http://www.w3.org/2001/XMLSchema#
obda:		https://w3id.org/obda/vocabulary#

[MappingDeclaration] @collection [[
mappingId	MAPPING-ID1
target		<http://metacatalog/entity_relationship/id={id}> a <http://metacatalog/entity_relationship> ; <http://metacatalog/entity_relationship#id> {id}^^xsd:string ; <http://metacatalog/entity_relationship#source_id> {source_id}^^xsd:string ; <http://metacatalog/entity_relationship#target_id> {target_id}^^xsd:string ; <http://metacatalog/entity_relationship#relation_type> {relation_type}^^xsd:string . 
source		SELECT * FROM "entity_relationship"

mappingId	MAPPING-ID2
target		<http://metacatalog/entity_relationship/id={entity_relationship_id}> <http://metacatalog/entity_relationship#ref-source_id> <http://metacatalog/entity/id={entity_id}> . 
source		SELECT "entity_relationship"."id" AS "entity_relationship_id", "entity"."id" AS "entity_id" FROM "entity_relationship", "entity" WHERE "entity_relationship"."source_id" = "entity"."id"

mappingId	MAPPING-ID3
target		<http://metacatalog/entity_relationship/id={entity_relationship_id}> <http://metacatalog/entity_relationship#ref-target_id> <http://metacatalog/entity/id={entity_id}> . 
source		SELECT "entity_relationship"."id" AS "entity_relationship_id", "entity"."id" AS "entity_id" FROM "entity_relationship", "entity" WHERE "entity_relationship"."target_id" = "entity"."id"

mappingId	MAPPING-ID4
target		<http://metacatalog/mapping_type_relationship/id={id}> a <http://metacatalog/mapping_type_relationship> ; <http://metacatalog/mapping_type_relationship#id> {id}^^xsd:string ; <http://metacatalog/mapping_type_relationship#source_id> {source_id}^^xsd:string ; <http://metacatalog/mapping_type_relationship#target_id> {target_id}^^xsd:string ; <http://metacatalog/mapping_type_relationship#relation_type> {relation_type}^^xsd:string ; <http://metacatalog/mapping_type_relationship#mapping_values> {mapping_values}^^xsd:string ; <http://metacatalog/mapping_type_relationship#entity_path_references> {entity_path_references}^^xsd:string . 
source		SELECT * FROM "mapping_type_relationship"

mappingId	MAPPING-ID5
target		<http://metacatalog/mapping_type_relationship/id={mapping_type_relationship_id}> <http://metacatalog/mapping_type_relationship#ref-source_id> <http://metacatalog/entity_type/id={entity_type_id}> . 
source		SELECT "mapping_type_relationship"."id" AS "mapping_type_relationship_id", "entity_type"."id" AS "entity_type_id" FROM "mapping_type_relationship", "entity_type" WHERE "mapping_type_relationship"."source_id" = "entity_type"."id"

mappingId	MAPPING-ID6
target		<http://metacatalog/mapping_type_relationship/id={mapping_type_relationship_id}> <http://metacatalog/mapping_type_relationship#ref-target_id> <http://metacatalog/entity_type/id={entity_type_id}> . 
source		SELECT "mapping_type_relationship"."id" AS "mapping_type_relationship_id", "entity_type"."id" AS "entity_type_id" FROM "mapping_type_relationship", "entity_type" WHERE "mapping_type_relationship"."target_id" = "entity_type"."id"

mappingId	MAPPING-ID7
target		<http://metacatalog/mapping_entity_relationship/id={id}> a <http://metacatalog/mapping_entity_relationship> ; <http://metacatalog/mapping_entity_relationship#id> {id}^^xsd:string ; <http://metacatalog/mapping_entity_relationship#source_id> {source_id}^^xsd:string ; <http://metacatalog/mapping_entity_relationship#target_id> {target_id}^^xsd:string ; <http://metacatalog/mapping_entity_relationship#relation_type> {relation_type}^^xsd:string ; <http://metacatalog/mapping_entity_relationship#mapping_entity_type_relationship_id> {mapping_entity_type_relationship_id}^^xsd:string . 
source		SELECT * FROM "mapping_entity_relationship"

mappingId	MAPPING-ID8
target		<http://metacatalog/mapping_entity_relationship/id={mapping_entity_relationship_id}> <http://metacatalog/mapping_entity_relationship#ref-source_id> <http://metacatalog/entity/id={entity_id}> . 
source		SELECT "mapping_entity_relationship"."id" AS "mapping_entity_relationship_id", "entity"."id" AS "entity_id" FROM "mapping_entity_relationship", "entity" WHERE "mapping_entity_relationship"."source_id" = "entity"."id"

mappingId	MAPPING-ID9
target		<http://metacatalog/mapping_entity_relationship/id={mapping_entity_relationship_id}> <http://metacatalog/mapping_entity_relationship#ref-target_id> <http://metacatalog/entity/id={entity_id}> . 
source		SELECT "mapping_entity_relationship"."id" AS "mapping_entity_relationship_id", "entity"."id" AS "entity_id" FROM "mapping_entity_relationship", "entity" WHERE "mapping_entity_relationship"."target_id" = "entity"."id"

mappingId	MAPPING-ID10
target		<http://metacatalog/mapping_entity_relationship/id={mapping_entity_relationship_id}> <http://metacatalog/mapping_entity_relationship#ref-mapping_entity_type_relationship_id> <http://metacatalog/mapping_type_relationship/id={mapping_type_relationship_id}> . 
source		SELECT "mapping_entity_relationship"."id" AS "mapping_entity_relationship_id", "mapping_type_relationship"."id" AS "mapping_type_relationship_id" FROM "mapping_entity_relationship", "mapping_type_relationship" WHERE "mapping_entity_relationship"."mapping_entity_type_relationship_id" = "mapping_type_relationship"."id"

mappingId	MAPPING-ID11
target		<http://metacatalog/trait_relationship/id={id}> a <http://metacatalog/trait_relationship> ; <http://metacatalog/trait_relationship#id> {id}^^xsd:string ; <http://metacatalog/trait_relationship#source_id> {source_id}^^xsd:string ; <http://metacatalog/trait_relationship#target_id> {target_id}^^xsd:string ; <http://metacatalog/trait_relationship#relation_type> {relation_type}^^xsd:string . 
source		SELECT * FROM "trait_relationship"

mappingId	MAPPING-ID12
target		<http://metacatalog/trait_relationship/id={trait_relationship_id}> <http://metacatalog/trait_relationship#ref-source_id> <http://metacatalog/trait/id={trait_id}> . 
source		SELECT "trait_relationship"."id" AS "trait_relationship_id", "trait"."id" AS "trait_id" FROM "trait_relationship", "trait" WHERE "trait_relationship"."source_id" = "trait"."id"

mappingId	MAPPING-ID13
target		<http://metacatalog/trait_relationship/id={trait_relationship_id}> <http://metacatalog/trait_relationship#ref-target_id> <http://metacatalog/trait/id={trait_id}> . 
source		SELECT "trait_relationship"."id" AS "trait_relationship_id", "trait"."id" AS "trait_id" FROM "trait_relationship", "trait" WHERE "trait_relationship"."target_id" = "trait"."id"

mappingId	MAPPING-ID14
target		<http://metacatalog/entity_type/id={id}> a <http://metacatalog/entity_type> ; <http://metacatalog/entity_type#id> {id}^^xsd:string ; <http://metacatalog/entity_type#name> {name}^^xsd:string ; <http://metacatalog/entity_type#base_schema> {base_schema}^^xsd:string ; <http://metacatalog/entity_type#derived_schema> {derived_schema}^^xsd:string ; <http://metacatalog/entity_type#father_id> {father_id}^^xsd:string . 
source		SELECT * FROM "entity_type"

mappingId	MAPPING-ID15
target		<http://metacatalog/entity_type/id={entity_type_FK_id}> <http://metacatalog/entity_type#ref-father_id> <http://metacatalog/entity_type/id={entity_type_FKR_id}> . 
source		SELECT "entity_type_FK"."id" AS "entity_type_FK_id", "entity_type_FKR"."id" AS "entity_type_FKR_id" FROM "entity_type" AS "entity_type_FK", "entity_type" AS "entity_type_FKR" WHERE "entity_type_FK"."father_id" = "entity_type_FKR"."id"

mappingId	MAPPING-ID17
target		<http://metacatalog/trait/id={id}> a <http://metacatalog/trait> ; <http://metacatalog/trait#id> {id}^^xsd:string ; <http://metacatalog/trait#name> {name}^^xsd:string ; <http://metacatalog/trait#base_schema> {base_schema}^^xsd:string ; <http://metacatalog/trait#derived_schema> {derived_schema}^^xsd:string ; <http://metacatalog/trait#father_id> {father_id}^^xsd:string . 
source		SELECT * FROM "trait"

mappingId	MAPPING-ID18
target		<http://metacatalog/trait/id={trait_FK_id}> <http://metacatalog/trait#ref-father_id> <http://metacatalog/trait/id={trait_FKR_id}> . 
source		SELECT "trait_FK"."id" AS "trait_FK_id", "trait_FKR"."id" AS "trait_FKR_id" FROM "trait" AS "trait_FK", "trait" AS "trait_FKR" WHERE "trait_FK"."father_id" = "trait_FKR"."id"

mappingId	MAPPING-ID19
target		<http://metacatalog/entity/id={id}> a <http://metacatalog/entity> ; <http://metacatalog/entity#id> {id}^^xsd:string ; <http://metacatalog/entity#values> {values}^^xsd:string ; <http://metacatalog/entity#entity_type_id> {entity_type_id}^^xsd:string . 
source		SELECT * FROM "entity"

mappingId	MAPPING-ID20
target		<http://metacatalog/entity/id={entity_id}> <http://metacatalog/entity#ref-entity_type_id> <http://metacatalog/entity_type/id={entity_type_id}> . 
source		SELECT "entity"."id" AS "entity_id", "entity_type"."id" AS "entity_type_id" FROM "entity", "entity_type" WHERE "entity"."entity_type_id" = "entity_type"."id"

]]

