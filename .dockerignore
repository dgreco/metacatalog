# Git
# NOTE: .git IS intentionally kept in the build context so the git-commit-id
# plugin can stamp the image with the current commit (surfaced at /actuator/info).
# Because .git changes on every commit, the `COPY . .` layer is invalidated per
# commit, which also guarantees `docker compose up --build` rebuilds the latest code.
.gitignore

# IDE
.idea
*.iml
.vscode
.settings
.project
.classpath

# Build outputs
**/target/
!**/target/*.jar

# Documentation
*.md
docs/

# Docker
Dockerfile
docker-compose*.yml
.dockerignore

# CI/CD
.gitlab-ci.yml
.github/

# Misc
*.log
*.tmp
.DS_Store
