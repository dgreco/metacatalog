<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>it.davidgreco</groupId>
        <artifactId>metacatalog</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>it.davidgreco.metacatalog</groupId>
    <artifactId>metacatalog-sparql</artifactId>
    <version>${project.version}</version>
    <name>Meta Catalog SPARQL</name>

    <dependencyManagement>
        <dependencies>
            <!--
                The versions the application ships of libraries Ontop shares with it.
                They are not bundled into the shaded jar (see the shade plugin below), so
                at runtime Ontop runs on the application's copies; pinning them here makes
                this module's tests run it on the same ones, not on Ontop's older picks.
            -->
            <dependency>
                <groupId>com.github.jsonld-java</groupId>
                <artifactId>jsonld-java</artifactId>
                <version>0.13.4</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>4.13.2</version>
            </dependency>
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
            <dependency>
                <groupId>org.checkerframework</groupId>
                <artifactId>checker-qual</artifactId>
                <version>3.55.1</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>4.4</version>
                <scope>compile</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <dependencies>
        <!--
            Spring MVC + embedded servlet container for the SPARQL endpoint, and
            Thymeleaf for its query UI. Provided, like spring-boot-jdbc below: the
            application ships both starters (metacatalog-ui and the application
            declare them), and the shade plugin bundles only compile and runtime
            scope, so none of their tree (Tomcat, Jackson, logback, ...) ends up
            duplicated inside the shaded jar.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            spring-boot-jdbc (provided): needed at compile time for
            DataSourceProperties (used by OntopRepositoryConfig to obtain JDBC
            coordinates without coupling to spring.datasource.* property names).
            At runtime the application module supplies this via spring-boot-starter-data-jpa.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-jdbc</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Ontop embedding (production-recommended RDF4J Repository API binding).
            ontop-system-sql-owlapi is the aggregate that pulls ontop-rdb (SQL
            reformulation + OBDA/R2RML parsers); ontop-rdf4j is declared explicitly
            so the RDF4J Repository API stays on the compile classpath even if Ontop
            reshuffles its transitive graph later. Version and logback/slf4j exclusions
            are managed in the parent dependencyManagement.

            Compile scope: bundled into this module's jar by the maven-shade-plugin
            (see <build> below) with net.sf.jsqlparser relocated to a private package,
            so Ontop's jsqlparser 4.x dependency does not leak onto the application
            classpath and clash with Spring Data JPA's jsqlparser 5.x API. This is
            mandatory: Ontop 5.5.0 calls the jsqlparser 4.x API Select.getSelectBody(),
            while Spring Data JPA 4.1 (metacatalog-core) calls the 5.x-only
            Select.getPlainSelect() — the two jsqlparser lines cannot coexist on one
            classpath. The shade plugin's dependency-reduced POM strips Ontop from the
            transitive graph of consumers that resolve this module from a repository;
            reactor builds read this POM instead, so metacatalog-application excludes
            it.unibz.inf.ontop from its dependency on this module.
        -->
        <dependency>
            <groupId>it.unibz.inf.ontop</groupId>
            <artifactId>ontop-system-sql-owlapi</artifactId>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>it.unibz.inf.ontop</groupId>
            <artifactId>ontop-rdf4j</artifactId>
            <scope>compile</scope>
        </dependency>
        <!--
            jsqlparser 4.4: bundled shaded (relocated) with Ontop so Ontop's
            Select.getSelectBody() calls resolve against the private copy. Compile
            scope so the shade plugin includes it; the reduced POM strips it from
            the transitive graph, and in reactor builds the parent's test-scope pin
            keeps it off the application's classpath. Version/scope forced by this
            module's dependencyManagement above (overriding the parent's 5.3 test pin).
        -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            Ontop's own Tomcat and Jackson dependencies, declared here so they reach
            the application as ordinary jars: the shade plugin leaves the Tomcat and
            Jackson groups out of the shaded jar (see below), and the application
            excludes Ontop's tree, so nothing else would bring these two in. The
            application already ships jackson-core/databind/annotations 2.x, and
            tomcat-juli's classes come with tomcat-embed-core, which ships them too.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-guava</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat</groupId>
            <artifactId>tomcat-jdbc</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.tomcat</groupId>
                    <artifactId>tomcat-juli</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
            RDF4J core API modules the sparql code references directly
            (Repository, Query/TupleQuery/GraphQuery, TurtleWriter). Declared
            explicitly — not transitive from the RIO writers below, and Ontop
            (which would otherwise bring them in transitively) is stripped from
            the application's classpath.
        -->
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-repository-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-query</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-turtle</artifactId>
        </dependency>
        <!--
            SPARQL query parser (QueryParserUtil / ParsedQuery) used by the
            controller to inspect the query type before dispatching to the
            typed prepare methods. Declared explicitly because the parent
            excludes the whole org.eclipse.rdf4j group from the Ontop deps.
        -->
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-queryparser-sparql</artifactId>
        </dependency>
        <!--
            RDF4J result-format writers and serializers used by the SPARQL
            protocol controller for content negotiation. The SPARQL Results
            JSON/XML/CSV/TSV writers and the N-Triples / RDF/XML RIO writers
            are NOT transitive from ontop-system-sql-owlapi — they must be
            declared explicitly, the same way Ontop's own ontop-endpoint/pom.xml
            does. Versions managed in the parent dependencyManagement.
        -->
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-queryresultio-sparqljson</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-queryresultio-sparqlxml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-queryresultio-text</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-ntriples</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.rdf4j</groupId>
            <artifactId>rdf4j-rio-rdfxml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Testing -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Test-only dependency on metacatalog-core: brings in the Flyway
            migration scripts (db/migration) and the Testcontainers support
            so the integration test can stand up the real schema and exercise
            the Ontop bean + SPARQL controller end to end.
        -->
        <dependency>
            <groupId>it.davidgreco.metacatalog</groupId>
            <artifactId>metacatalog-core</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Enforcer Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>

            <!-- Compiler Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!--
                maven-shade-plugin: bundle Ontop and the libraries only Ontop needs into
                the sparql jar, relocating the two packages that clash with metacatalog-core.
                createDependencyReducedPom=true strips the bundled artifacts from the
                published POM. A reactor build still reads the original one and would
                package Ontop unshaded next to this jar, so metacatalog-application
                excludes it.unibz.inf.ontop from its dependency on this module.

                Two relocations are mandatory:
                  - net.sf.jsqlparser: Ontop 5.5.0 calls jsqlparser 4.x API
                    (Select.getSelectBody()); Spring Data JPA 4.1 calls jsqlparser
                    5.x-only API (Select.getPlainSelect()). Both lines cannot
                    coexist. The shaded copy is relocated to a private package so
                    net.sf.jsqlparser never appears on the app classpath, and
                    Spring Data JPA's ClassUtils.isPresent check returns false →
                    it falls back to the default query enhancer.
                  - org.jgrapht: Ontop 5.5.0 depends on the ancient
                    org.javabits.jgrapht:jgrapht-core:0.9.3 (DefaultDirectedGraph
                    implements DirectedGraph), while metacatalog-core uses
                    org.jgrapht:jgrapht-core:1.5.3 where DirectedGraph was removed.
                    Both cannot coexist — bundle Ontop's 0.9.3 and relocate
                    org.jgrapht to a private package.

                We bundle Ontop's transitive graph minus an explicit list rather than
                cherry-picking artifacts: cherry-picking (via <artifactSet><includes>)
                orphaned Ontop's non-bundled transitives (Guice, OWL API) under the
                reduced POM, causing NoClassDefFoundError at runtime. The list leaves
                out RDF4J (managed separately at 5.3.0), Spring, Lombok, test deps, and
                every library the application ships as a jar anyway (Tomcat, Jackson,
                logback, Guava, the Commons libraries, ...): a bundled, unrelocated copy
                of one would only race the application's on the classpath, so Ontop
                uses the application's. ShadedSparqlJarTest in metacatalog-application
                checks both directions against the application's runtime classpath.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <!-- RDF4J managed separately at 5.3.0 -->
                                    <exclude>org.eclipse.rdf4j:*</exclude>
                                    <!-- Spring managed by Spring Boot parent -->
                                    <exclude>org.springframework:*</exclude>
                                    <exclude>org.springframework.boot:*</exclude>
                                    <exclude>org.springframework.data:*</exclude>
                                    <exclude>org.springframework.security:*</exclude>
                                    <!-- Test-only deps -->
                                    <exclude>org.junit.jupiter:*</exclude>
                                    <exclude>org.assertj:*</exclude>
                                    <exclude>org.mockito:*</exclude>
                                    <exclude>org.testcontainers:*</exclude>
                                    <exclude>org.junit.platform:*</exclude>
                                    <!-- Tomcat, Jackson and logback: the application ships
                                         them as jars, so a bundled copy would only race
                                         them on the classpath. Ontop's own Tomcat and
                                         Jackson artifacts are declared as dependencies
                                         above instead. -->
                                    <exclude>org.apache.tomcat:*</exclude>
                                    <exclude>org.apache.tomcat.embed:*</exclude>
                                    <exclude>com.fasterxml.jackson.core:*</exclude>
                                    <exclude>com.fasterxml.jackson.datatype:*</exclude>
                                    <exclude>tools.jackson.core:*</exclude>
                                    <exclude>ch.qos.logback:*</exclude>
                                    <!-- Every other library Ontop shares with the application:
                                         the application ships each of these as a jar, so Ontop
                                         uses that copy. ShadedSparqlJarTest (application module)
                                         fails if one is bundled again, or if the application
                                         stops shipping one Ontop needs (aopalliance's classes
                                         come with spring-aop). Ontop's old JGraphT is
                                         not here: it shares only a name with the application's,
                                         and stays bundled, relocated. -->
                                    <exclude>aopalliance:aopalliance</exclude>
                                    <exclude>com.github.jsonld-java:jsonld-java</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                    <exclude>com.google.errorprone:error_prone_annotations</exclude>
                                    <exclude>com.google.guava:failureaccess</exclude>
                                    <exclude>com.google.guava:guava</exclude>
                                    <exclude>com.google.guava:listenablefuture</exclude>
                                    <exclude>com.google.j2objc:j2objc-annotations</exclude>
                                    <exclude>com.opencsv:opencsv</exclude>
                                    <exclude>com.zaxxer:HikariCP</exclude>
                                    <exclude>commons-beanutils:commons-beanutils</exclude>
                                    <exclude>commons-codec:commons-codec</exclude>
                                    <exclude>commons-collections:commons-collections</exclude>
                                    <exclude>commons-io:commons-io</exclude>
                                    <exclude>no.hasmac:hasmac-json-ld</exclude>
                                    <exclude>org.antlr:antlr4-runtime</exclude>
                                    <exclude>org.apache.commons:commons-collections4</exclude>
                                    <exclude>org.apache.commons:commons-lang3</exclude>
                                    <exclude>org.apache.commons:commons-text</exclude>
                                    <exclude>org.apache.httpcomponents:httpcore</exclude>
                                    <exclude>org.checkerframework:checker-qual</exclude>
                                    <exclude>org.jspecify:jspecify</exclude>
                                    <exclude>org.slf4j:jcl-over-slf4j</exclude>
                                    <exclude>org.slf4j:slf4j-api</exclude>
                                    <!-- Lombok: annotation processor, not runtime -->
                                    <exclude>org.projectlombok:*</exclude>
                                    <!-- other metacatalog modules: keep them out of the sparql uber-jar.
                                         The sparql module's own classes MUST stay — a wildcard
                                         it.davidgreco.metacatalog:* exclude would strip them too,
                                         leaving the shaded jar with no controllers/template. -->
                                    <exclude>it.davidgreco.metacatalog:metacatalog-core</exclude>
                                    <exclude>it.davidgreco.metacatalog:metacatalog-functions</exclude>
                                    <exclude>it.davidgreco.metacatalog:metacatalog-openapi</exclude>
                                    <exclude>it.davidgreco.metacatalog:metacatalog-ui</exclude>
                                    <exclude>it.davidgreco.metacatalog:metacatalog-security</exclude>
                                    <exclude>it.davidgreco.metacatalog:metacatalog-application</exclude>
                                </excludes>
                            </artifactSet>
                            <!-- nullanno redefines jsr305's javax.annotation.Nonnull and
                                 Nullable; the application ships jsr305, so only nullanno's
                                 own Eclipse annotations are bundled. -->
                            <filters>
                                <filter>
                                    <artifact>io.github.solf:nullanno</artifact>
                                    <excludes>
                                        <exclude>javax/annotation/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>net.sf.jsqlparser</pattern>
                                    <shadedPattern>it.davidgreco.metacatalog.sparql.shaded.jsqlparser</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.jgrapht</pattern>
                                    <shadedPattern>it.davidgreco.metacatalog.sparql.shaded.jgrapht</shadedPattern>
                                </relocation>
                            </relocations>
                            <createDependencyReducedPom>true</createDependencyReducedPom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- JaCoCo Plugin -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!-- Spotless Plugin for Code Formatting -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <!-- licensescan Maven plugin for License check -->
            <plugin>
                <groupId>com.github.carlomorelli</groupId>
                <artifactId>licensescan-maven-plugin</artifactId>
            </plugin>

            <!-- maven-surefire-plugin to run unit tests through the command line -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
